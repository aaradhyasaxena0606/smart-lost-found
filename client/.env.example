# Frontend environment configuration (copy to client/.env)
#
# Leave VITE_API_URL unset to use the relative "/api/v1" path, which works with
# the Vite dev proxy and behind a production reverse proxy.
#
# VITE_API_URL=http://localhost:4000/api/v1
# Set only when images are served from a different origin than the page.
# VITE_API_ORIGIN=http://localhost:4000
