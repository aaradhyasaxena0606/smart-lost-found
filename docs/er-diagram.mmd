%%{ init: { "theme": "base", "themeVariables": { "fontFamily": "system-ui, sans-serif" } } }%%
erDiagram
    users ||--o{ items : "reports"
    users ||--o{ claims : "submits"
    users ||--o{ claims : "reviews"
    users ||--o{ notifications : "receives"
    users ||--o{ audit_logs : "acts"

    categories ||--o{ items : "classifies"

    items ||--o{ item_images : "has"
    items ||--o| item_private_details : "has at most one"

    items ||--o{ matches : "appears as lost side"
    items ||--o{ matches : "appears as found side"

    items ||--o{ claims : "is claimed"
    claims ||--o{ notifications : "may reference"

    users {
        INTEGER  user_id PK "GENERATED BY DEFAULT AS IDENTITY"
        VARCHAR  full_name "NOT NULL, 2-120 chars"
        VARCHAR  email UK "NOT NULL, lower-cased, UNIQUE"
        VARCHAR  password_hash "NOT NULL, bcrypt hash"
        VARCHAR  role "NOT NULL, CHECK in (user, admin)"
        BOOLEAN  is_active "NOT NULL default TRUE"
        TIMESTAMPTZ created_at "NOT NULL default now()"
        TIMESTAMPTZ updated_at "NOT NULL default now(), trigger"
    }

    categories {
        INTEGER  category_id PK
        VARCHAR  name UK "NOT NULL, UNIQUE"
        VARCHAR  description "NULL"
        TIMESTAMPTZ created_at "NOT NULL default now()"
        TIMESTAMPTZ updated_at "NOT NULL default now()"
    }

    items {
        INTEGER  item_id PK
        INTEGER  reporter_id FK "NOT NULL -> users.user_id ON DELETE RESTRICT"
        INTEGER  category_id FK "NOT NULL -> categories.category_id ON DELETE RESTRICT"
        VARCHAR  report_type "NOT NULL, CHECK in (lost, found)"
        VARCHAR  title "NOT NULL, 3-200 chars"
        TEXT     description "NOT NULL, 10-5000 chars"
        VARCHAR  colour "NULL"
        VARCHAR  brand "NULL"
        TIMESTAMPTZ event_time "NOT NULL"
        VARCHAR  location_name "NULL"
        GEOGRAPHY location "geography(Point,4326) NULL, GiST indexed"
        VARCHAR  status "NOT NULL, CHECK in (open, matched, claimed, returned, closed, rejected)"
        TIMESTAMPTZ created_at "NOT NULL default now()"
        TIMESTAMPTZ updated_at "NOT NULL default now(), trigger"
        TIMESTAMPTZ closed_at "NULL, CHECK >= created_at"
        TIMESTAMPTZ deleted_at "NULL, soft delete marker"
    }

    item_images {
        INTEGER  image_id PK
        INTEGER  item_id FK "NOT NULL -> items ON DELETE CASCADE"
        VARCHAR  storage_key UK "NOT NULL, server-generated"
        VARCHAR  mime_type "NOT NULL, CHECK in (image/jpeg, image/png, image/webp)"
        INTEGER  byte_size "NOT NULL, CHECK 1 byte .. 10 MB"
        VARCHAR  alt_text "NULL"
        TIMESTAMPTZ uploaded_at "NOT NULL default now()"
    }

    item_private_details {
        INTEGER  private_detail_id PK
        INTEGER  item_id FK "NOT NULL, UNIQUE (1:0..1) -> items ON DELETE CASCADE"
        VARCHAR  verification_hint "NULL, access-restricted"
        TIMESTAMPTZ created_at "NOT NULL default now()"
        TIMESTAMPTZ updated_at "NOT NULL default now()"
    }

    matches {
        INTEGER  match_id PK
        INTEGER  lost_item_id FK "NOT NULL -> items, report_type must be lost (trigger)"
        INTEGER  found_item_id FK "NOT NULL -> items, report_type must be found (trigger)"
        NUMERIC  attribute_score "NOT NULL, CHECK 0-100"
        NUMERIC  time_score "NOT NULL, CHECK 0-100"
        NUMERIC  spatial_score "NULL, CHECK 0-100"
        NUMERIC  ai_score "NULL, CHECK 0-100"
        NUMERIC  overall_score "NOT NULL, CHECK 0-100"
        VARCHAR  match_status "NOT NULL, CHECK in (suggested, dismissed, claimed, resolved)"
        JSONB    match_reasons "NOT NULL, CHECK jsonb_typeof = array"
        TIMESTAMPTZ created_at "NOT NULL default now()"
        TIMESTAMPTZ updated_at "NOT NULL default now()"
    }

    claims {
        INTEGER  claim_id PK
        INTEGER  item_id FK "NOT NULL -> items ON DELETE RESTRICT"
        INTEGER  claimant_id FK "NOT NULL -> users ON DELETE RESTRICT"
        TEXT     claim_message "NOT NULL, 10-2000 chars"
        VARCHAR  private_evidence "NULL, never returned by the API"
        VARCHAR  status "NOT NULL, CHECK in (pending, approved, rejected, withdrawn)"
        INTEGER  reviewed_by FK "NULL -> users ON DELETE SET NULL, CHECK <> claimant_id"
        TIMESTAMPTZ reviewed_at "NULL, CHECK consistent with status"
        VARCHAR  review_reason "NULL, required when rejected"
        TIMESTAMPTZ created_at "NOT NULL default now()"
        TIMESTAMPTZ updated_at "NOT NULL default now()"
    }

    notifications {
        INTEGER  notification_id PK
        INTEGER  user_id FK "NOT NULL -> users ON DELETE CASCADE"
        VARCHAR  notification_type "NOT NULL, CHECK in 8 values"
        VARCHAR  title "NOT NULL"
        VARCHAR  message "NOT NULL"
        INTEGER  related_item_id FK "NULL -> items ON DELETE CASCADE"
        INTEGER  related_claim_id FK "NULL -> claims ON DELETE CASCADE"
        BOOLEAN  is_read "NOT NULL default FALSE"
        TIMESTAMPTZ created_at "NOT NULL default now()"
    }

    audit_logs {
        BIGINT   audit_id PK
        INTEGER  actor_user_id FK "NULL -> users ON DELETE SET NULL"
        VARCHAR  action "NOT NULL"
        VARCHAR  entity_type "NOT NULL"
        INTEGER  entity_id "NULL"
        JSONB    metadata "NOT NULL default {} , non-secret only"
        TIMESTAMPTZ created_at "NOT NULL default now()"
    }
