{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart Lost & Found REST API (Node.js + Express + PostgreSQL/PostGIS)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 --import ./tests/helpers/load-test-env.js \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 --test-timeout=120000 --import ./tests/helpers/load-test-env.js \"tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
