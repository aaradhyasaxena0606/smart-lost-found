# ============================================================================
# Smart Lost & Found - environment configuration example
# Copy this file to `.env` in the repository root and replace every value.
# NEVER commit a real `.env` file. NEVER reuse these placeholder secrets.
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL + PostGIS) ---
# The password MUST be percent-encoded inside the URL.
# Example: password "P@ss word" -> "P%40ss%20word"
# A superuser is required the first time so that `CREATE EXTENSION postgis` works.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/smart_lost_found

# Separate database used only by the automated test suite. It is truncated
# between test files, so never point it at a database holding real data.
TEST_DATABASE_URL=postgresql://postgres:change_me@localhost:5432/smart_lost_found_test

# --- Managed Postgres options (optional) ---
# Connection pool ceiling. Managed free tiers allow few connections; keep this
# small (for example 5) when the API runs on a free tier or serverless platform.
# PGPOOL_MAX=10
#
# Some providers install PostGIS into a schema other than `public`. Supabase uses
# `extensions`, so set this to "public, extensions" there, otherwise the
# `geography` type and PostGIS functions are not found.
# PG_SEARCH_PATH=public, extensions

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# --- Uploads ---
# Directory is resolved relative to the repository root when the backend starts.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Rate limiting (spec 16) ---
# RATE_LIMIT_WINDOW_MINUTES=15
# Production defaults: 10 auth requests / 300 API requests per IP per window.
# Development defaults are relaxed (1000 / 10000) so the test suite is not
# throttled. Set these explicitly to override either behaviour.
# RATE_LIMIT_AUTH_MAX=1000
# RATE_LIMIT_API_MAX=10000

# --- Reverse proxy / logging (optional) ---
# Set TRUST_PROXY=true only when the API runs behind a reverse proxy that sets
# X-Forwarded-For, so client IPs (and therefore rate limits) stay accurate.
# TRUST_PROXY=false
# LOG_REQUESTS=true

# --- Matching engine (deterministic baseline) ---
MATCH_RADIUS_METERS=1500
MATCH_MAX_DAYS=30
MATCH_MIN_SCORE=40
MATCH_WEIGHT_ATTRIBUTE=0.35
MATCH_WEIGHT_TIME=0.20
MATCH_WEIGHT_SPATIAL=0.25
MATCH_WEIGHT_AI=0.20

# --- Optional AI provider adapter ---
# AI_PROVIDER=disabled keeps the application fully functional using only the
# deterministic engine. Supported values: disabled | openai
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=text-embedding-3-small
AI_TIMEOUT_MS=5000
AI_BASE_URL=https://api.openai.com/v1
